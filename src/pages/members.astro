---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import Footer from "../components/Footer.astro";
import MemberCard from "../components/MemberCard.astro";

const members = (await getCollection("members")).sort((a, b) => a.data.order - b.data.order);
---
<Base lang="zh" title="修士名录 · 空想花庭"
      description="修道院的住客：复旦大学空想世界创作者协会成员名录。"
      active="members" canvas="pollen">

<div class="wall-page">

  <div class="wall-head">
    <h1 data-scramble="修士名录">修士名录</h1>
    <div class="wall-latin">· REGISTER · THE FRIARS ·</div>
    <svg id="vine" viewBox="0 0 420 40" aria-hidden="true">
      <path d="M10 30 C60 5 90 35 140 20 S240 5 290 22 S380 30 410 14 M70 24 q4 -10 12 -8 M210 18 q4 10 12 8 M330 22 q-6 -8 2 -14"/>
    </svg>
    <p class="mono meta">REGISTER · 以下名录以第一届小说节在册作品为准，其余社员名录编目中</p>
  </div>

  <div class="wall" style="column-count:4;max-width:1100px">
    {members.map((m) => <MemberCard member={m} lang="zh" />)}
  </div>
</div>

<Footer lang="zh" mid="members" />
</Base>
