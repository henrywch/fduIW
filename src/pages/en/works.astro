---
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import Base from "../../layouts/Base.astro";
import Footer from "../../components/Footer.astro";
import imgHangzhouPanes from "../../assets/image/杭城十二时辰-窗格.jpg";
import imgHangzhouCoverFull from "../../assets/image/杭城十二时辰-封面-全.jpg";
import imgCyberFortuneTelling from "../../assets/image/cyber-fortune-telling.png";
import imgMidnightBroadcast from "../../assets/image/midnight-broadcast.jpg";
import imgSunsetFactory from "../../assets/image/sunset-factory.jpg";

const novels = new Map((await getCollection("works")).map((w) => [w.id.split("/").pop()!, w]));

const B = (import.meta.env.BASE_URL || "/").replace(/\/$/, ""); // "" at site root, "/fduIW" on GitHub Pages

const EN: Record<string, { genre: string; blurb: string }> = {
  "hangzhou-twelve-hours": { genre: "Fantasy", blurb: "\"Twelve Hours of Hangzhou\" — Best Fantasy & Most Promising, 1st Fiction Festival" },
  "cyber-fortune-telling": { genre: "Sci-fi", blurb: "\"Have You Had Your Fortune Told?\" — Best Sci-fi, 1st Fiction Festival" },
  "midnight-broadcast-notes": { genre: "Mystery", blurb: "\"Midnight Radio Journals\" — Best Mystery, 1st Fiction Festival" },
  "silver-age": { genre: "Story / Characters", blurb: "\"The Silver Age\" — Best Story & Best Characters, 1st Fiction Festival" },
};

const CAT_EN = { fantasy: "FANTASY", illustration: "PAINTING", workview: "WORLDVIEW" } as const;
const catLabelEn = (c: string) => (CAT_EN as Record<string, string>)[c] ?? c;

// mirrors .wall in site.css: 3 cols (max-width 1200px, 2rem side padding, 1.4rem gaps),
// 2 cols ≤960px, 1 col ≤600px — sizes must follow the column width per viewport
const wallSizes =
  "(max-width: 600px) calc(100vw - 4rem), (max-width: 960px) calc((100vw - 5.4rem) / 2), (max-width: 1200px) calc((100vw - 6.8rem) / 3), 364px";

// slug entries link to a work's detail page; the tail entry is a standalone piece
// whose branch is selected via `"slug" in item` (astro check doesn't trust truthiness narrowing)
type WallEntry =
  | { slug: string; img: ImageMetadata }
  | { cats: string[]; img: ImageMetadata; alt: string; title: string; meta: string; blurb?: string; href?: string };

// web-sourced images dress headers only; wall art is processed at build time (astro:assets)
const wall: WallEntry[] = [
  { slug: "hangzhou-twelve-hours", img: imgHangzhouPanes },
  { slug: "cyber-fortune-telling", img: imgCyberFortuneTelling },
  { slug: "midnight-broadcast-notes", img: imgMidnightBroadcast },
  { slug: "silver-age", img: imgSunsetFactory },
  { cats: ["workview"], img: imgHangzhouCoverFull, alt: "Qing-min bestiary excerpt", title: "青民谱系 · 节录",
    meta: "魔王与小玖 · worldbuilding", blurb: "The Qing-min bestiary — shares a world with \"Twelve Hours of Hangzhou\"",
    href: `${B}/works/hangzhou-twelve-hours/` },
];
---
<Base lang="en" title="The Garden · Hortus de Escapismo"
      description="The gallery wall: novels, paintings and settings, grown freely."
      active="works" canvas="pollen" themeClass="wide">

<div class="wall-page">

  <div class="wall-head">
    <h1 class="latin" data-scramble="The Garden">The Garden</h1>
    <div class="wall-latin">花庭 · THE LIVING WALL</div>
    <svg id="vine" viewBox="0 0 420 40" aria-hidden="true">
      <path d="M10 30 C60 5 90 35 140 20 S240 5 290 22 S380 30 410 14 M70 24 q4 -10 12 -8 M210 18 q4 10 12 8 M330 22 q-6 -8 2 -14"/>
    </svg>
    <p class="mono meta">GALLERY WALL · translations in progress — links open the Chinese originals</p>
  </div>

  <div class="seeds">
    <button class="seed active" data-f="all">All</button>
    <button class="seed" data-f="fantasy">Fantasy</button>
    <button class="seed" data-f="illustration">Illustration</button>
    <button class="seed" data-f="workview">Worldview</button>
  </div>

  <div class="wall">

    {wall.map((item) => {
      if ("slug" in item) {
        const w = novels.get(item.slug)!;
        const en = EN[w.id.split("/").pop()!];
        return (
          <a class="living" data-f={w.data.cats.join(" ")} href={`${B}/works/${w.id.split("/").pop()}/`}>
            <span class="medium-tag">{w.data.cats.map(catLabelEn).join(" · ")}</span>
            <Image src={item.img} alt={w.data.title} loading="lazy" decoding="async"
                   widths={[480, 960, 1600]} sizes={wallSizes} />
            <div class="stem">
              <h3 data-scramble={w.data.title}>{w.data.title}</h3>
              <div class="meta">{w.data.author} · {w.data.date} · {en.genre}</div>
              <p>{en.blurb}</p>
            </div>
          </a>
        );
      }
      return (
        <a class="living" data-f={item.cats.join(" ")} href={item.href || item.img.src}>
          <span class="medium-tag">{item.cats.map(catLabelEn).join(" · ")}</span>
          <Image src={item.img} alt={item.alt} loading="lazy" decoding="async"
                 widths={[480, 960, 1600]} sizes={wallSizes} />
          <div class="stem">
            <h3 data-scramble={item.title}>{item.title}</h3>
            <div class="meta">{item.meta}</div>
            {item.blurb && <p>{item.blurb}</p>}
          </div>
        </a>
      );
    })}

  </div>
</div>

<Footer lang="en" mid="works" />
</Base>
