---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import Footer from "../components/Footer.astro";

const novels = new Map((await getCollection("works")).map((w) => [w.id.split("/").pop()!, w]));

const CAT_ZH = { fantasy: "幻想", illustration: "笔墨", workview: "世界观" } as const;
const catLabelZh = (c: string) => (CAT_ZH as Record<string, string>)[c] ?? c;
const genreOf = (tags: string[]) => tags.filter((t) => ["奇幻", "科幻", "悬疑"].includes(t))[0] || "文";

// web-sourced images dress headers only; the wall shows originals only
const wall = [
  { slug: "hangzhou-twelve-hours", img: "/assets/image/杭城十二时辰-窗格.jpg" },
  { slug: "cyber-fortune-telling", img: "/assets/image/cyber-fortune-telling.png" },
  { slug: "midnight-broadcast-notes", img: "/assets/image/midnight-broadcast.jpg" },
  { slug: "silver-age", img: "/assets/image/sunset-factory.jpg" },
  { cats: ["workview"], img: "/assets/image/杭城十二时辰-封面-全.jpg", alt: "青民谱系 节录", title: "青民谱系 · 节录",
    meta: "魔王与小玖 · 世界观设定", blurb: "妖盟、青莲堂与杭城，设定同《杭城十二时辰》共享一界",
    href: "/works/hangzhou-twelve-hours/" },
];
---
<Base lang="zh" title="花庭 · 空想花庭"
      description="住客作品画廊：小说、画作、OC 设定，自由生长的花墙。"
      active="works" canvas="pollen" themeClass="wide">

<div class="wall-page">

  <div class="wall-head">
    <h1 data-scramble="花庭">花庭</h1>
    <div class="wall-latin">· HORTUS · THE LIVING WALL ·</div>
    <svg id="vine" viewBox="0 0 420 40" aria-hidden="true">
      <path d="M10 30 C60 5 90 35 140 20 S240 5 290 22 S380 30 410 14 M70 24 q4 -10 12 -8 M210 18 q4 10 12 8 M330 22 q-6 -8 2 -14"/>
    </svg>
    <p class="mono meta">GALLERY WALL · 每一株花都是一位住客所种</p>
  </div>

  <div class="seeds">
    <button class="seed active" data-f="all">全部 · ALL</button>
    <button class="seed" data-f="fantasy">幻想 · FANTASY</button>
    <button class="seed" data-f="illustration">笔墨 · ILLUSTRATION</button>
    <button class="seed" data-f="workview">世界观 · WORLDVIEW</button>
  </div>

  <div class="wall">

    {wall.map((item) => item.slug ? (() => {
      const w = novels.get(item.slug)!;
      return (
        <a class="living" data-f={w.data.cats.join(" ")} href={`/works/${w.id.split("/").pop()}/`}>
          <span class="medium-tag">{w.data.cats.map(catLabelZh).join(" · ")}</span>
          <img src={item.img} alt={w.data.title + " 封面"} loading="lazy" />
          <div class="stem">
            <h3 data-scramble={w.data.title}>{w.data.title}</h3>
            <div class="meta">{w.data.author} · {w.data.date} · {genreOf(w.data.tags)}</div>
            <p>{w.data.subtitle}</p>
          </div>
        </a>
      );
    })() : (
      <a class="living" data-f={item.cats.join(" ")} href={item.href || item.img}>
        <span class="medium-tag">{item.cats.map(catLabelZh).join(" · ")}</span>
        <img src={item.img} alt={item.alt} loading="lazy" />
        <div class="stem">
          <h3 data-scramble={item.title}>{item.title}</h3>
          <div class="meta">{item.meta}</div>
          {item.blurb && <p>{item.blurb}</p>}
        </div>
      </a>
    ))}

  </div>
</div>

<Footer lang="zh" mid="works" />
</Base>
